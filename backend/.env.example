# Postgres connection string (Neon or local). Must be a psycopg3-compatible URL.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# development | test | production
ENV=development

# Origin allowed by CORS for the Vite frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated allowed CORS origins for production (e.g. the Vercel
# deployment URL). Leave empty in local dev -- FRONTEND_ORIGIN above covers
# that case. Never "*": cookie auth (session 02) is incompatible with a
# wildcard origin.
COMPASS_CORS_ORIGINS=

# "inline" (default, FastAPI BackgroundTasks) or "actions" (dispatch to a
# GitHub Actions worker -- see DEPLOY.md).
COMPASS_WORKER_MODE=inline

# Required only when COMPASS_WORKER_MODE=actions. "{owner}/{repo}" of the
# PUBLIC repository whose .github/workflows/mine.yml receives the dispatch.
COMPASS_WORKER_REPO=

# Required only when COMPASS_WORKER_MODE=actions. A fine-grained PAT scoped
# to Actions: read and write on COMPASS_WORKER_REPO only. Never log this,
# never return it from any API.
COMPASS_WORKER_PAT=

# Repos larger than this (per the GitHub API's reported size) are rejected
# at submission rather than analyzed slowly.
COMPASS_MAX_REPO_MB=300

# Surfaced by GET /health -- bump when cutting a release so the keep-alive
# ping also proves which build is running.
COMPASS_VERSION=0.1.0
