# Postgres connection string (Neon or local). Must be a psycopg3-compatible URL.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# development | test | production
ENV=development

# Origin allowed by CORS for the Vite frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated allowed CORS origins for production (e.g. the Vercel
# deployment URL). Leave empty in local dev -- FRONTEND_ORIGIN above covers
# that case. Never "*": cookie auth (session 02) is incompatible with a
# wildcard origin.
COMPASS_CORS_ORIGINS=

# "inline" (default, FastAPI BackgroundTasks) or "actions" (dispatch to a
# GitHub Actions worker -- see DEPLOY.md).
COMPASS_WORKER_MODE=inline

# Required only when COMPASS_WORKER_MODE=actions. "{owner}/{repo}" of the
# PUBLIC repository whose .github/workflows/mine.yml receives the dispatch.
COMPASS_WORKER_REPO=

# Required only when COMPASS_WORKER_MODE=actions. A fine-grained PAT scoped
# to Actions: read and write on COMPASS_WORKER_REPO only. Never log this,
# never return it from any API.
COMPASS_WORKER_PAT=

# Repos larger than this (per the GitHub API's reported size) are rejected
# at submission rather than analyzed slowly.
COMPASS_MAX_REPO_MB=300

# Surfaced by GET /health -- bump when cutting a release so the keep-alive
# ping also proves which build is running.
COMPASS_VERSION=0.1.0

# --- Session 02: GitHub OAuth, private repos, sharing --------------------

# From the GitHub OAuth App you create per DEPLOY.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Signs the session/OAuth-state JWT cookies. Any long random string --
# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COMPASS_JWT_SECRET=

# Fernet key encrypting GitHub tokens at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Missing/invalid is startup-fatal when COMPASS_ENV=production; in
# development an ephemeral key is derived instead (with a loud warning) --
# fine for local dev, never acceptable beyond it.
COMPASS_TOKEN_ENCRYPTION_KEY=

# Where OAuth callbacks redirect back to (the Vite dev server locally).
COMPASS_FRONTEND_URL=http://localhost:5173

# development | production -- gates the COMPASS_TOKEN_ENCRYPTION_KEY
# startup assertion above. Distinct from ENV (kept for back-compat); new
# code reads this one.
COMPASS_ENV=development

# Rate limits for POST /repos (app/api/limits.py) -- tunable without a code
# change. Defaults shown are the plan/RULES.md-specified values.
COMPASS_RATE_LIMIT_ANON_PER_HOUR=3
COMPASS_RATE_LIMIT_ANON_PER_DAY=10
COMPASS_RATE_LIMIT_USER_PER_HOUR=20
COMPASS_RATE_LIMIT_USER_PER_DAY=100
COMPASS_MAX_CONCURRENT_RUNS=3

# --- Session 10: secret scanning -----------------------------------------

# Stable salt mixed into every scanned secret's fingerprint
# (app/security/scanner.py). Not startup-fatal like COMPASS_TOKEN_ENCRYPTION_KEY
# (a fingerprint can't be reversed to the secret value), but should still be
# overridden in any real deployment so fingerprints aren't guessable across
# deployments by anyone who knows this default. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
COMPASS_SECRET_SCAN_SALT=compass-secret-scan-dev-salt
