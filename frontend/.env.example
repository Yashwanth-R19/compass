# Base URL of the Compass backend API (see backend/README quickstart).
# Local dev: the API on :8000 (also the default when unset in dev).
# Production (Vercel): leave UNSET, or set to /api -- frontend/vercel.json
# proxies /api/* to the Render backend so the session cookie is first-party.
# Pointing this at the Render URL directly breaks login in browsers that
# block third-party cookies.
VITE_API_URL=http://localhost:8000
